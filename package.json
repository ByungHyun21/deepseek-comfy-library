{
  "name": "deepseek-comfy-library",
  "version": "0.2.0",
  "description": "에이전트가 ComfyUI로 만든 이미지·비디오·음악 갤러리와 설치된 모델 목록을 DeepSeek Harness에 더한다",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByungHyun21/deepseek-comfy-library.git"
  },
  "homepage": "https://github.com/ByungHyun21/deepseek-comfy-library#readme",
  "bugs": {
    "url": "https://github.com/ByungHyun21/deepseek-comfy-library/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "comfyui",
    "gallery",
    "image-generation",
    "stable-diffusion"
  ],
  "main": "./plugin/host.js",
  "exports": {
    ".": "./plugin/host.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin/host.js",
    "lib/comfy.js",
    "lib/remote.js",
    "lib/client.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs/*.png"
  ],
  "scripts": {
    "check": "node --check plugin/host.js && node --check lib/comfy.js && node --check lib/remote.js && node --check lib/client.js",
    "test": "npm run check && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.5 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
